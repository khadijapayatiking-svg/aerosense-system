# Copy this file to .env and replace DJANGO_SECRET_KEY with a 50+ character
# random value. Generate one with:
# .\.venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Required. The placeholder below is not valid; replace it with a 50+ character
# random value or Django will refuse to start.
DJANGO_SECRET_KEY=replace-with-a-50-plus-character-random-value

# True for local development. False is required for production and for the
# `manage.py check --deploy` verification.
DJANGO_DEBUG=True

# Comma-separated host names. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins including scheme. For same-origin development only the
# Django origin is needed; the Vite dev server defaults to http://localhost:5173
# and is used only for modules/HMR, so do not add it here unless you deliberately
# split the frontend and backend origins.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Production overrides. Leave these at the secure defaults when DEBUG=False.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True

# Set to True only when Django is behind a proxy that sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HEADERS=False
